rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /of_chars/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_series/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_products/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_cos/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_pos/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_ships/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_pkgs/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
    match /of_customers/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isValidId(id);
    }
  }
}
