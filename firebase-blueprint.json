{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "Characters/IP figures managed in the database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Series": {
      "title": "Series",
      "description": "Product series and brands",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Combinations of series, characters, specs, and price tags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seriesId": { "type": "string" },
        "characterId": { "type": "string" },
        "spec": { "type": "string" },
        "price": { "type": "string" }
      },
      "required": ["id", "seriesId"]
    },
    "ClientOrder": {
      "title": "ClientOrder",
      "description": "Client orders containing items and logistics status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerIG": { "type": "string" },
        "clientOrdered": { "type": "boolean" },
        "items": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerIG", "items", "createdAt"]
    },
    "PreOrder": {
      "title": "PreOrder",
      "description": "Pre-orders made with card swipe summaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stage": { "type": "string" },
        "cardAmount": { "type": "string" },
        "notes": { "type": "string" },
        "linkedItems": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "stage", "createdAt"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "International shipping cargo orders and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stage": { "type": "string" },
        "shippingCost": { "type": "string" },
        "poIds": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "stage", "createdAt"]
    },
    "PackagingCost": {
      "title": "PackagingCost",
      "description": "Cost registers for wrapping sheet materials, bubbles, and boxes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "amount", "date", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profiles under master registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "customerIG": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "customerIG", "createdAt"]
    }
  },
  "firestore": {
    "of_chars": {
      "schema": "Character",
      "description": "Characters database"
    },
    "of_series": {
      "schema": "Series",
      "description": "Product series database"
    },
    "of_products": {
      "schema": "Product",
      "description": "Products list with metadata"
    },
    "of_cos": {
      "schema": "ClientOrder",
      "description": "Client orders matching IG profiles"
    },
    "of_pos": {
      "schema": "PreOrder",
      "description": "Credit purchase registers"
    },
    "of_ships": {
      "schema": "Shipment",
      "description": "Shipment stages registry"
    },
    "of_pkgs": {
      "schema": "PackagingCost",
      "description": "Packaging box expenses"
    },
    "of_customers": {
      "schema": "Customer",
      "description": "Customer Master database"
    }
  }
}
